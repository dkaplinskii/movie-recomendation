PORT=80
SHUTDOWN_TIMEOUT=5s
RATE_LIMIT_PER_MIN=1000
RATE_BURST=5
# Rate limit exclude paths (comma separated)
RATE_LIMIT_EXCLUDE_PATHS=/health
# Authentication
VALID_TOKENS=secret-token-1,secret-token-2,admin-token-2024

# Swagger Configuration
SWAGGER_HOST=localhost:80
API_VERSION=1.0
API_TITLE=API Gateway
API_DESCRIPTION=API Gateway for Movie Recommendation Platform
API_BASE_PATH=/
SWAGGER_SCHEMES=http
