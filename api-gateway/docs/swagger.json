    "host": "localhost:80",
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "description": "Check if the service is alive",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/test": {
            "get": {
                "description": "Simple test endpoint",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Test endpoint",
                "responses": {
                    "200": {
                        "description": "test ok",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}