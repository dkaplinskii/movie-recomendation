APP_ENV=local
APP_NAME=review-service
APP_LOG_LEVEL=info

GRPC_PORT=50051

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB_NAME=review_service
POSTGRES_SSLMODE=disable
POSTGRES_MIGRATIONS_PATH=./migrations

KAFKA_BROKERS=kafka:9092
KAFKA_REVIEW_EVENTS_TOPIC=reviews.created
KAFKA_PRODUCER_REQUIRED_ACKS=1
KAFKA_PRODUCER_RETRY_MAX=3
KAFKA_PRODUCER_TIMEOUT=10s

SHUTDOWN_TIMEOUT=5s