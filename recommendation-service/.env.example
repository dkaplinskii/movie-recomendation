APP_NAME=recommendation-service
APP_ENV=local
LOG_LEVEL=debug

GRPC_PORT=50051

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STARTUP_TIMEOUT=10s

RECOMMENDATION_CACHE_TTL=24h

KAFKA_BROKERS=kafka:9092
KAFKA_REVIEW_EVENTS_TOPIC=reviews.created
KAFKA_GROUP_ID=recommendation-service
KAFKA_CONSUMER_AUTO_COMMIT_INTERVAL=1s

KAFKA_RECOMMENDATION_EVENTS_TOPIC=recommendations.ready
KAFKA_PRODUCER_REQUIRED_ACKS=1
KAFKA_PRODUCER_RETRY_MAX=3
KAFKA_PRODUCER_TIMEOUT=10s

SHUTDOWN_TIMEOUT=10s

RECOMMENDATION_LATEST_REVIEWS_LIMIT=100
RECOMMENDATION_SIZE=10
RECOMMENDATION_MIN_PREFERENCE_SCORE=7.0
RECOMMENDATION_MAX_FILTER_VALUES=5
RECOMMENDATION_PREFERRED_YEAR_RANGE=5

RECOMMENDATION_GENRE_WEIGHT=0.4
RECOMMENDATION_COUNTRY_WEIGHT=0.3
RECOMMENDATION_YEAR_WEIGHT=0.2
RECOMMENDATION_RATING_WEIGHT=0.1
RECOMMENDATION_MIN_YEAR_SAMPLE_SIZE=2
RECOMMENDATION_CANDIDATE_POOL_SIZE=50