APP_ENV=local
APP_NAME=movie-service
APP_LOG_LEVEL=info


POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB_NAME=movie_service
POSTGRES_SSLMODE=disable
POSTGRES_MIGRATIONS_PATH=./migrations

GRPC_PORT=50051

KINOPOISK_API_URL=https://kinopoiskapiunofficial.tech
KINOPOISK_API_KEY=your_api_key
KINOPOISK_TIMEOUT=5s

SHUTDOWN_TIMEOUT=5s